# API endpoint used by the console
RELEASEA_API_BASE_URL=http://localhost:8070/api
RELEASEA_PLATFORM_NAMESPACE=releasea-system
RELEASEA_WORKER_API_BASE_URL=http://releasea-api.releasea-system.svc.cluster.local:8070/api/v1
RELEASEA_WORKER_STALE_SECONDS=90
RELEASEA_ISTIO_NAMESPACE=istio-system
RELEASEA_INTERNAL_GATEWAY_NAME=releasea-internal-gateway
RELEASEA_EXTERNAL_GATEWAY_NAME=releasea-external-gateway

# Auth UI defaults
RELEASEA_ENABLE_SIGNUP=false
RELEASEA_ADMIN_EMAIL=admin@releasea.io

# External links
RELEASEA_DOCS_URL=https://docs.releasea.io

# Default public template source
RELEASEA_TEMPLATE_OWNER=releasea
RELEASEA_TEMPLATE_REPO=templates
